# CIAGA environment variables
#
# Nothing documented the required set before this file, so a new machine had to
# reverse-engineer it from `process.env` usages and per-script header comments.
# Copy the relevant block into the matching .env.local and fill in real values.
# All real .env files are gitignored — never put real values here.
#
# Three files are in play:
#   .env.local            repo root — used by scripts/ and by `npm run dev:app`
#   apps/app/.env.local   the PWA
#   apps/web/.env.local   the marketing site
#
# Local dev points at the STAGING Supabase project, not production.


# ── Supabase ────────────────────────────────────────────────────────────────
# Root + apps/app. Staging project ref: balcwdqjzouufxigszup
NEXT_PUBLIC_SUPABASE_URL=https://balcwdqjzouufxigszup.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gates every /api/sandbox route and the "Pull from Production" dev tool.
# Currently set ONLY in the root .env.local, not apps/app/.env.local — so the
# sandbox routes are inert when running the app locally. Deliberate; see the
# Gotchas section of CLAUDE.md.
NEXT_PUBLIC_APP_ENV=development


# ── Auth / admin ────────────────────────────────────────────────────────────
# Root + apps/app. Compared with safeCompare in lib/auth/safeCompare.ts.
ADMIN_API_KEY=

# Read by app/api/cron/auto-complete-rounds and app/api/cron/entry-open-notifications,
# which reject the request without it. Set in Vercel only — it is in NO local env
# file, so the cron routes cannot be exercised locally as-is.
CRON_SECRET=


# ── Web push (apps/app) ─────────────────────────────────────────────────────
# Push only works in a production build, not `next dev`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@ciagagolf.com


# ── Analytics (apps/app + apps/web) ─────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com


# ── Course lookup (root + apps/app) ─────────────────────────────────────────
GOLFCOURSE_API_KEY=
GOLFCOURSE_API_BASE=
GOLFCOURSE_MAX_KM_NAMED=
GOLFCOURSE_MAX_KM_UNNAMED=
GOLFCOURSE_MIN_NAME_SIMILARITY=
GOLFCOURSE_MIN_FINAL_SCORE=
GOLFCOURSE_MIN_FINAL_SCORE_UNNAMED=

# OpenStreetMap. Note the two names for one concept: NOMINATIM_USER_AGENT is set
# in the env files, but app/api/courses/resolve/route.ts reads
# OSM_NOMINATIM_USER_AGENT. Both have code fallbacks, so neither is load-bearing
# — worth collapsing to one name.
OVERPASS_USER_AGENT=
NOMINATIM_USER_AGENT=
# OSM_NOMINATIM_USER_AGENT=
# NOMINATIM_BASE=https://nominatim.openstreetmap.org


# ── Public URLs ─────────────────────────────────────────────────────────────
# Three names exist for nearly the same thing. All have code fallbacks, so none
# is required, but the split is a trap when changing a domain:
#   NEXT_PUBLIC_APP_URL   apps/web only — the one actually set today
#   NEXT_PUBLIC_SITE_URL  apps/app: invite/redeem redirect origins (4 uses), unset
#   NEXT_PUBLIC_WEB_URL   apps/app: lib/legal.ts link base, unset
NEXT_PUBLIC_APP_URL=https://app.ciagagolf.com
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_WEB_URL=https://ciagagolf.com


# ── Scripts only ────────────────────────────────────────────────────────────
# Production credentials, used by the one-off backfill scripts under
# scripts/invitational-backfill/ (which expect their own .env.prod — a file that
# does not currently exist) and by scripts/recompress-storage-images.mjs.
# Not needed for ordinary development.
# PROD_SUPABASE_URL=
# PROD_SUPABASE_SERVICE_ROLE_KEY=
