# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# monorepo
/apps/**/node_modules/
/apps/**/.next/

# AI assistant files: track CLAUDE.md + shared config, ignore local/session files.
# Anything not negated here is invisible to git, so a new .claude/ subdirectory
# must be added below or it silently never gets committed.
.claude/*
!.claude/skills/
!.claude/rules/
!.claude/hooks/
!.claude/settings.json
!.claude/db-environments.json

# Windows artifacts
nul

# Browser verification scratch output (the /verify skill writes these to the
# repo root). Evidence for a single session, not repo content.
/verify-*.png
/.playwright-mcp/

# Scratch working files (analysis output, one-off renders). Not repo content.
/.scratch/

# next-pwa build output. `withPWA({ dest: 'public' })` regenerates these on every
# production build, and workbox/worker filenames carry a fresh content hash, so
# tracking them meant each build deleted one file and added another — a
# permanently dirty tree that hid real changes. Vercel regenerates them at deploy
# time; nothing needs the committed copy.
/apps/app/public/sw.js
/apps/app/public/sw.js.map
/apps/app/public/workbox-*.js
/apps/app/public/workbox-*.js.map
/apps/app/public/worker-*.js
/apps/app/public/worker-*.js.map

.vercel
.env*

# The documented key list is deliberately tracked; real values never are.
!.env.example
